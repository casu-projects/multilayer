<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CasuMpGateway</AssemblyName>
    <RootNamespace>CasuMpGateway</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    게이트웨이는 오케스트레이터와 동일한 독립 프로세스 모델(PLAN.md 게이트웨이 섹션 G2/G12).
    LiteNetLib은 게임(모드)과 동일한 실제 파일을 참조한다(순수 .NET 소켓 — net8.0 호환).
    Steamworks.NET은 Linux 패킹(Pack=4)으로 빌드된 버전을 사용한다(오케스트레이터와 동일).
    SteamKit2는 스팀 로비(SteamLobbyAdapter)용.
  -->
  <ItemGroup>
    <Reference Include="LiteNetLib">
      <HintPath>../../assets/casualties-together/LiteNetLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Steamworks">
      <HintPath>../../assets/casualties-together-linux/Steamworks.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>

  <!-- Steamworks.NET 런타임 의존성 — 게임 인스턴스 디렉토리(루트 instance/)의 네이티브 라이브러리를 출력에 복사 -->
  <ItemGroup>
    <None Include="../../instance/libsteam_api.so" Link="libsteam_api.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../instance/steam_appid.txt" Link="steam_appid.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
