<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CasuMpOrchestrator</AssemblyName>
    <RootNamespace>CasuMpOrchestrator</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- 제어 허브(ControlHub): 게이트웨이/에이전트/모드 3종 클라이언트를 TCP로 수용 (PLAN.md D3/O6-1) -->

  <!-- Discord 관리 봇 (D1) — 구 시스템과 동일 버전 (검증됨) -->
  <ItemGroup>
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\CasuMp.Protocol\CasuMp.Protocol.csproj" />
    <ProjectReference Include="..\shared\CasuMp.Runtime\CasuMp.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="CasuMp.Protocol" />
    <Using Include="CasuMp.Runtime" />
  </ItemGroup>

</Project>
