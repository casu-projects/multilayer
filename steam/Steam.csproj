<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CasuMpSteam</AssemblyName>
    <RootNamespace>CasuMpSteam</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.4.0" />
    <PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LiteNetLib">
      <HintPath>../../assets/dependency/casualties-together/LiteNetLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Steamworks">
      <HintPath>../third_party/steamworks/Steamworks.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\CasuMp.Protocol\CasuMp.Protocol.csproj" />
    <ProjectReference Include="..\shared\CasuMp.Runtime\CasuMp.Runtime.csproj" />
    <ProjectReference Include="..\shared\CasuMp.SteamSession\CasuMp.SteamSession.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/dependency/casualties-together/libsteam_api.so" Link="libsteam_api.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/dependency/casualties-together/steam_appid.txt" Link="steam_appid.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="CasuMp.Protocol" />
    <Using Include="CasuMp.Runtime" />
  </ItemGroup>

</Project>
